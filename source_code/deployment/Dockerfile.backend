# Build context is source_code/ (one level up from this file)
FROM python:3.13-slim

# Security: run as non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

WORKDIR /app

# Install dependencies first (layer caching)
COPY dependency_reader/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source and fix permissions so appuser can write json reports
COPY dependency_reader/ .
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

# 4 uvicorn workers — I/O-bound async API benefits from multiple workers
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
